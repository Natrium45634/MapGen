#pragma code_page(65001)
#include <winver.h>

IDI_ICON1 ICON "@PROJECT_SOURCE_DIR@/packaging/mapgen.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "CompanyName", "MapGen"
            VALUE "FileDescription", "MapGen — генератор физико-географических карт"
            VALUE "FileVersion", "@PROJECT_VERSION@.0"
            VALUE "InternalName", "MapGen"
            VALUE "OriginalFilename", "MapGen.exe"
            VALUE "ProductName", "MapGen"
            VALUE "ProductVersion", "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
